# GENESIS Memory OS — gitignore (standalone repo)
# Runtime state lives in ~/.genesis/, never in this repo.

# Real environment with keys (template .env.example IS committed)
/.env

# SQLite databases (runtime DB is ~/.genesis/memory.db; tests use tmp_path)
*.db
*.sqlite3
*.db-wal
*.db-shm
*.sqlite3-wal
*.sqlite3-shm

# Lossless spool evidence (raw command output, stays local)
spool/
*.log

# Machine backups + generated sleep history
backups/
sleep_reports/
sleep_report_*.md

# Python caches and build artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
