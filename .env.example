# GENESIS Memory Configuration

# Path to persistent SQLite memory database
GENESIS_DAEMON_DB=~/.genesis/memory.db

# Proxy Gateway Port & Target
GENESIS_PROXY_PORT=8000
GENESIS_UPSTREAM_URL=https://openrouter.ai/api/v1

# Dashboard Port
GENESIS_DASHBOARD_PORT=8080

# Logging level (DEBUG, INFO, WARNING, ERROR, or off)
GENESIS_DAEMON_LOG=INFO
