"GENESIS Proxy and Memory Deck API", "version": "1.4-production"}, "openapi": "3.1.0", "paths": {"/": {"get": {"operationId": "root", "responses": {"200": {"description": "Service descriptor with endpoint map."}}}}, "/health": {"get": {"operationId": "health", "responses": {"200": {"description": "ok with mode, target_model, store_active, rss."}}}}, "/v1/chat/completions": {"post": {"description": "OpenAI-compatible chat through the strip and memory pipeline.", "operationId": "chatCompletions", "requestBody": {"content": {"application/json": {"schema": {"properties": {"messages": {"type": "array"}, "model": {"type": "string"}, "stream": {"type": "boolean"}}, "required": ["messages"], "type": "object"}}}, "required": true}, "responses": {"200": {"description": "Upstream JSON verbatim (+ X-Genesis-Receipt header when non-streaming) or SSE stream.", "headers": {"X-Genesis-Receipt": {"$ref": "#/components/headers/X-Genesis-Receipt"}}}, "400": {"description": "Invalid JSON payload."}, "502": {"description": "Upstream connection failed."}}}}, "/v1/models": {"get": {"operationId": "listModels", "responses": {"200": {"description": "Upstream catalog or offline fallback list."}}}}, "/v1/pricing": {"get": {"operationId": "pricing", "parameters": [{"in": "query", "name": "limit", "schema": {"type": "string"}}, {"in": "query", "name": "paid_only", "schema": {"type": "string"}}, {"in": "query", "name": "provider", "schema": {"type": "string"}}, {"in": "query", "name": "q", "schema": {"type": "string"}}, {"in": "query", "name": "sort", "schema": {"type": "string"}}], "responses": {"200": {"description": "Rate catalog page."}}}}, "/v1/pricing/refresh": {"get": {"operationId": "pricingRefresh", "responses": {"200": {"description": "Refresh result."}}}, "post": {"operationId": "pricingRefreshPost", "responses": {"200": {"description": "Refresh result."}}}}, "/v1/receipts": {"get": {"operationId": "listReceipts", "parameters": [{"in": "query", "name": "limit", "schema": {"default": 20, "type": "integer"}}], "responses": {"200": {"description": "Newest-first receipts (ring buffer 100)."}}}}, "/v1/receipts/{rid}": {"get": {"operationId": "getReceipt", "parameters": [{"in": "path", "name": "rid", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "One receipt."}, "404": {"description": "Unknown receipt id."}}}}, "/v1/recovery/{rid}": {"get": {"operationId": "getRecovery", "parameters": [{"in": "path", "name": "rid", "required": true, "schema": {"pattern": "^[0-9a-f]{16}$", "type": "string"}}], "responses": {"200": {"description": "Byte-exact stored original."}, "404": {"description": "Unknown or expired id."}, "503": {"description": "Store unavailable."}}}}, "/v1/telemetry": {"get": {"operationId": "telemetry", "responses": {"200": {"description": "Counters, cache accounting, cost_accounting, distillation, performance, rss."}}}}, "/v1/telemetry/reset": {"post": {"operationId": "telemetryReset", "responses": {"200": {"description": "Counters reset."}}}}}, "servers": [{"description": "Local proxy", "url": "http://127.0.0.1:8000"}, {"description": "Local memory deck", "url": "http://127.0.0.1:8090"}]}
